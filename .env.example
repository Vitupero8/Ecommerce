# Copy this file to .env and replace every value.
# .env is gitignored - never commit real passwords or keys.
# Do not use the ' character in passwords.

# MySQL administrator (used ONLY by the init scripts, never by the apps)
MYSQL_ROOT_PASSWORD=change-me-root

# One password per microservice database user
CUSTOMER_DB_PASSWORD=change-me-customer
PRODUCT_DB_PASSWORD=change-me-product
CART_DB_PASSWORD=change-me-cart
PAYMENT_DB_PASSWORD=change-me-payment
SHIPMENT_DB_PASSWORD=change-me-shipment

# JWT signing key shared by Customer (signs) and Cart/Payment/Shipment (validate).
# Must be at least 32 characters (HMAC-SHA256 needs a 256-bit key).
JWT_KEY=change-me-to-a-long-random-string-at-least-32-chars

# PayPal Sandbox app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=change-me
PAYPAL_CLIENT_SECRET=change-me
